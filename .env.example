# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*

# Scraper URLs
SCRAPER_BASE_URL=https://webscraper.io/test-sites
SCRAPER_ECOMMERCE_URL=https://webscraper.io/test-sites/e-commerce/allinone

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
SCRAPER_MAX_LIMIT=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Optional shared secret for POST /discover /locators /execute
# Accepts Authorization: Bearer <token> or X-Service-Token: <token>
# Leave empty to disable auth (local/dev)
PLAYWRIGHT_SERVICE_TOKEN=
